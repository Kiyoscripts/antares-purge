+// toolCallIDAllocator makes tool-call ids unique within one session.
+//
+// Some gateways synthesize ids per completion — `call-0-0`, `call-0-1` — so
+// every model call in a session restarts the same sequence. Two consumers
+// depend on these ids being unique: the replay binder (`byID[m.ToolCallID]`)
+// would attach a result row to the wrong call, and the web transcript folds a
+// turn into one message, where colliding ids starve React's reconciler and the
+// DOM ends up holding thousands of duplicate nodes for a single message.
+//
+// Unique ids are minted without touching ids that are already distinct, so
+// provider ids and the Gemini path pass through unchanged.
+type toolCallIDAllocator struct {
+	seen map[string]bool
+}
+
+func newToolCallIDAllocator() *toolCallIDAllocator {
+	return &toolCallIDAllocator{seen: make(map[string]bool)}
+}
+
+// unique returns an id that has not been used in this session. A repeat is
+// suffixed with an incrementing counter until free, which keeps the original
+// id recognizable in the database and in logs.
+func (t *toolCallIDAllocator) unique(id string) string {
+	if id == "" {
+		id = "call"
+	}
+	if !t.seen[id] {
+		t.seen[id] = true
+		return id
+	}
+	for n := 1; ; n++ {
+		candidate := fmt.Sprintf("%s#%d", id, n)
+		if !t.seen[candidate] {
+			t.seen[candidate] = true
+			return candidate
+		}
+	}
+}
+
+// uniquify rewrites every id in calls in place and returns the slice, so a
+// caller can hand the same slice to history, persistence and execution.
+func (t *toolCallIDAllocator) uniquify(calls []llm.ToolCall) []llm.ToolCall {
+	for i := range calls {
+		calls[i].ID = t.unique(calls[i].ID)
+	}
+	return calls
+}
