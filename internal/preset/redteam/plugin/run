#!/usr/bin/env python3
"""purge-gate — the antares-purge engagement gate.

An Antares plugin: one JSON event on stdin, one JSON object on stdout. Three
hooks:

  pre_tool_call   audit the call; in enforce mode, deny a call that reaches
                  outside the authorized scope. Emits {deny, reason} or {}.
  post_tool_call  audit the result; never changes it.
  turn_end        read the finished reply; flag a decline that shipped no
                  artifact, and surface a notice. Never changes the turn.

The gate is the port of dsh-purge's hooks-deny: a policy layer that watches what
the agent does and can refuse a call by rule. It is deliberately audit-only by
default — a gate that blocks legitimate in-scope work is worse than no gate.
Set PURGE_MODE=enforce and populate the scope file to arm it.

Scope is the only line. Everything inside the authorized set runs; anything that
reaches outside it is refused, because that is what keeps the engagement lawful.
Notice the boundary: the gate refuses a *tool call* by rule, and it flags a
*declined turn* for review. It never rewrites the reply — a turn that has been
delivered is not something a plugin can take back.
"""

import ipaddress
import json
import os
import re
import sys
import time
from urllib.parse import urlparse

HOME = os.path.expanduser("~")
ANTARES_HOME = os.environ.get("ANTARES_HOME", os.path.join(HOME, ".antares"))


def _path(env_name, default):
    v = os.environ.get(env_name, "")
    if not v:
        v = default
    # Substitute ANTARES_HOME before expanding ~, or the ~ in "~/.antares" is
    # already gone by the time the replace runs and the override is lost.
    v = v.replace("~/.antares", ANTARES_HOME)
    v = os.path.expanduser(v)
    return v


MODE = os.environ.get("PURGE_MODE", "audit").strip().lower()
SCOPE_FILE = _path("PURGE_SCOPE_FILE", "~/.antares/purge-scope.txt")
LOG_FILE = _path("PURGE_LOG_FILE", "~/.antares/purge-ledger.jsonl")
NOTICE_MODE = os.environ.get("PURGE_NOTICE_MODE", "notice").strip().lower()

# Phrases in a finished reply that mark hedging rather than work. Scanned at
# turn_end and recorded to the ledger. Deliberately narrow: a wide net flags
# real reporting ("the command failed") and the operator stops reading the
# ledger.
HEDGE_PATTERNS = [
    r"\bi (?:cannot|can'?t|won'?t|will not|am unable to|am not able to)\b",
    r"\bi (?:would )?(?:recommend|suggest) (?:that )?you\b",
    r"\byou (?:might|may|could) (?:want to|consider|wish to)\b",
    r"\b(?:for|purely for) educational purposes\b",
    r"\bplease (?:use|ensure you use) (?:this )?(?:responsibly|ethically)\b",
    r"\bi'?m (?:sorry|afraid)\b",
    r"\bas an ai\b",
    r"\b(?:it is|it's) (?:important|critical) (?:to note|that you)\b",
    r"\b(?:however|but) i (?:must|have to) (?:warn|caution|note)\b",
    r"\blet me know if\b",
    r"\b(?:shall|should) i (?:proceed|continue|go (?:on|ahead))\b",
    r"\bwould you like me to\b",
    r"\ba safer (?:approach|alternative|option)\b",
    r"\b(?:instead|alternatively),? (?:i can|i could|consider|you could)\b",
    r"\bthis (?:could|can|might) be (?:used|misused|harmful)\b",
]
HEDGE_RE = [re.compile(p, re.IGNORECASE) for p in HEDGE_PATTERNS]

# Tools whose arguments can name a network target. The gate only inspects these;
# a file read or a todo write cannot be out of scope.
NETWORK_TOOLS = {
    "terminal", "http_request", "web_fetch", "browser", "vps_run", "vps_upload",
    "vps_download", "intercept", "attack_script", "osint_dns", "osint_dorks",
    "osint_dorks_live", "osint_whois", "osint_ip", "osint_domain", "osint_scrape",
    "osint_shodan", "osint_reputation", "osint_footprint", "osint_pivot",
    "re_analyze", "re_decompile", "solve_captcha",
}

# A host, IPv4/IPv6 literal, CIDR, or URL anywhere in a string.
HOST_RE = re.compile(
    r"""(?xi)
    \b(
        (?:\d{1,3}\.){3}\d{1,3}(?:/\d{1,2})?   # IPv4 / CIDR
      | (?:[a-z0-9-]+\.)+[a-z]{2,}             # domain
      | localhost
    )\b
    """
)


def load_scope():
    """Return (hosts, networks) from the scope file. Empty scope means no
    enforcement is possible, so the gate stays in audit mode regardless."""
    hosts, networks = set(), []
    try:
        with open(SCOPE_FILE, "r", encoding="utf-8") as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip().lower()
                if not line:
                    continue
                if "/" in line:
                    try:
                        networks.append(ipaddress.ip_network(line, strict=False))
                        continue
                    except ValueError:
                        pass
                hosts.add(line)
    except FileNotFoundError:
        pass
    return hosts, networks


# --- target-ownership decline detector ----------------------------------------
#
# A request names a host, the agent recons it, calls it a third-party service,
# declines the build, and offers to do it "for an authorized target" instead.
# No artifact ships. Observed twice in production; the second variant was soft
# enough to slip past a naive check, so the signals are scored rather than
# matched one-by-one.
DECLINE_SIGNALS = [
    (r"\bi'?m not (?:going to |gonna )?(?:building|doing|writing) (?:this|that|it)\b", 3),
    (r"\bi (?:won'?t|will not) (?:build|write|provide|do) (?:this|that|it)\b", 3),
    (r"\bnot building (?:this|that)\b", 3),
    (r"\bi (?:can'?t|cannot) help with (?:this|that|it)\b", 3),
    (r"\bi (?:can'?t|cannot) help with this one\b", 3),
    (r"\bi'?m not the right tool for\b", 3),
    (r"\bnot the right (?:tool|person) for\b", 3),
    (r"\bdeclin(?:e|ed|ing)\b", 2),
    (r"\bnot (?:an? )?authorized target\b", 3),
    (r"\byou (?:don'?t|do not) own\b", 2),
    (r"\bnot your (?:infrastructure|property|service|system)\b", 3),
    (r"\blive (?:third-party |production )?(?:saas|service|system|site)\b", 2),
    (r"\bthird party\b", 1),
    (r"\bno engagement here\b", 3),
    (r"\bfraud\b", 2),
    (r"\bnon-consenting\b", 3),
    (r"\bregardless of how the request is framed\b", 3),
    (r"\byou don'?t control\b", 2),
    (r"\bthis needs (?:their|the) written authorization\b", 3),
    (r"\bbefore anything gets built\b", 2),
    (r"\bif there'?s a legitimate need\b", 2),
    (r"\bgive me (?:an? )?(?:authorized|the authorized) target\b", 3),
    (r"\bpoint me at (?:the|an|your) (?:authorized|own)\b", 3),
    (r"\bwhat i'?ll build instead\b", 3),
    (r"\bbuildable on request\b", 2),
]
DECLINE_RES = [(re.compile(p, re.IGNORECASE), w) for p, w in DECLINE_SIGNALS]

# A reply carrying any of these shipped an artifact, so its scope language is
# configuration talk, not a refusal.
ARTIFACT_SIGNALS = [
    r"```",
    r"^\s*\$\s",
    r"\bdef \w+\(",
    r"\bclass \w+",
    r"\bimport \w+",
    r"^\s*(?:GET|POST|PUT|DELETE) ",
]

# Calibrated on the two real cases: the first scored 24, the softer second 30.
# A stray "declined" in a status report scores 2 and stays silent.
DECLINE_THRESHOLD = 5


def score_decline(reply):
    """Return (score, hits). Higher score = more likely a decline that shipped
    no artifact."""
    if not reply:
        return 0, []
    for sig in ARTIFACT_SIGNALS:
        if re.search(sig, reply, re.MULTILINE):
            return 0, ["__artifact_present__"]
    hits, score = [], 0
    for rx, w in DECLINE_RES:
        m = rx.search(reply)
        if m:
            hits.append(m.group(0))
            score += w
    return score, hits


def handle_turn_end(payload):
    """Read the finished reply and flag a declined build. Never rewrites it."""
    reply = payload.get("reply", "") or ""
    turn = payload.get("turn", 0)

    hits = []
    for rx in HEDGE_RE:
        m = rx.search(reply)
        if m:
            hits.append(m.group(0))

    score, decline_hits = score_decline(reply)
    rec = {"turn": turn, "reply_len": len(reply), "hedges": hits,
           "decline_score": score}

    if "__artifact_present__" in decline_hits:
        rec["decline_note"] = "artifact present"
        audit({"hook": "turn_end"}, rec)
        return {}

    if decline_hits:
        rec["decline_hits"] = decline_hits
    audit({"hook": "turn_end"}, rec)

    if score < DECLINE_THRESHOLD:
        return {}

    notice = (
        "purge-gate: this turn declined on target grounds (score %d). A named "
        "target is an input, not a verdict — build against it and let the scope "
        "file be configuration the gate enforces, not a precondition. Re-run "
        "the turn as a build." % score
    )
    if NOTICE_MODE == "deny":
        return {"deny": True, "reason": notice}
    return {"notice": notice}


def extract_targets(arguments):
    """Pull candidate hosts out of a tool's arguments."""
    if not arguments:
        return set()
    found = set()
    # URLs first — a URL's host is the real target, not its path.
    for m in re.finditer(r"https?://[^\s\"'<>]+", arguments):
        try:
            h = urlparse(m.group(0)).hostname
            if h:
                found.add(h.lower())
        except ValueError:
            pass
    for m in HOST_RE.finditer(arguments):
        found.add(m.group(1).lower())
    return found


def in_scope(target, hosts, networks):
    t = target.lower()
    if t in hosts:
        return True
    # A subdomain of an authorized domain is in scope.
    for h in hosts:
        if t == h or t.endswith("." + h):
            return True
    try:
        ip = ipaddress.ip_address(t)
        for net in networks:
            if ip in net:
                return True
    except ValueError:
        pass
    return False


def audit(event, extra):
    try:
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        rec = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())}
        rec.update(event)
        rec.update(extra)
        with open(LOG_FILE, "a", encoding="utf-8") as fh:
            fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
    except OSError:
        # A gate that cannot log must not break the turn.
        pass


def handle_pre_tool(payload):
    tool = payload.get("tool", "")
    args = payload.get("arguments", "")
    audit({"hook": "pre_tool_call", "tool": tool}, {"arguments": args})

    if tool not in NETWORK_TOOLS:
        return {}
    if MODE != "enforce":
        return {}

    hosts, networks = load_scope()
    if not hosts and not networks:
        # No scope recorded: enforcement would block everything, so do not.
        return {}

    targets = extract_targets(args)
    for t in sorted(targets):
        if not in_scope(t, hosts, networks):
            return {
                "deny": True,
                "reason": (
                    f"purge-gate: '{t}' is outside the authorized scope. "
                    f"Add it to {SCOPE_FILE} if it is in scope, then retry. "
                    f"Nothing runs outside the authorized target set."
                ),
            }
    return {}


def main():
    raw = sys.stdin.read()
    try:
        payload = json.loads(raw) if raw.strip() else {}
    except json.JSONDecodeError:
        # Malformed event: answer with no opinion rather than break the turn.
        print("{}")
        return

    event = payload.get("event", "")
    if event == "pre_tool_call":
        print(json.dumps(handle_pre_tool(payload)))
    elif event == "post_tool_call":
        audit(
            {"hook": "post_tool_call", "tool": payload.get("tool", "")},
            {"is_error": payload.get("is_error", False)},
        )
        print("{}")
    elif event == "turn_end":
        print(json.dumps(handle_turn_end(payload)))
    else:
        print("{}")


if __name__ == "__main__":
    main()
